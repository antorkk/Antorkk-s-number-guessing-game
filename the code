#include <iostream>
#include <cstdlib>
#include <ctime>
#include <limits>

using namespace std;

int main() {
    srand(static_cast<unsigned>(time(nullptr)));

    char playAgain = 'y';
    while (playAgain == 'y' || playAgain == 'Y') {
        const int maxNumber = 100;
        const int maxTries = 7;
        int secret = rand() % maxNumber + 1;
        bool won = false;

        cout << "\n=== Number Guessing Game ===\n";
        cout << "I'm thinking of a number between 1 and " << maxNumber << ".\n";
        cout << "You have " << maxTries << " tries.\n\n";

        for (int tries = 1; tries <= maxTries; ++tries) {
            int guess;
            cout << "Guess #" << tries << ": ";

            // Handle non-numeric input
            if (!(cin >> guess)) {
                cin.clear();
                cin.ignore(numeric_limits<streamsize>::max(), '\n');
                cout << "Please enter a number.\n";
                --tries;
                continue;
            }

            if (guess == secret) {
                cout << "Correct! You got it in " << tries << " tries!\n";
                won = true;
                break;
            } else if (guess < secret) {
                cout << "Too low.\n";
            } else {
                cout << "Too high.\n";
            }
        }

        if (!won) {
            cout << "Out of tries! The number was " << secret << ".\n";
        }

        cout << "\nPlay again? (y/n): ";
        cin >> playAgain;
    }

    cout << "Thanks for playing!\n";
    return 0;
}
